# Server
PORT=3000
PUBLIC_BASE_URL=https://your-render-service.onrender.com

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_with_random_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
OWNER_WHATSAPP_NUMBER=2348012345678

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deriv API (use a trade-scoped PAT or OAuth token; never commit real values)
DERIV_APP_ID=
DERIV_ACCESS_TOKEN=
DERIV_ACCOUNT_ID=
# DEMO_ONLY=true blocks real-account trading even if credentials point to a real account.
DEMO_ONLY=true
ENABLE_LIVE_TRADING=false

# Risk controls
DEFAULT_STAKE=1
MAX_STAKE=2
MAX_TRADES_PER_DAY=5
MAX_DAILY_STAKE_RISK=5
MAX_OPEN_TRADES=1
SYMBOL=R_100
CANDLE_GRANULARITY=60
SCAN_INTERVAL_SECONDS=60
