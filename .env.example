# Server
PORT=3000

# Twilio WhatsApp sender lookup (keep values private; configure in Render Environment)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_LOOKUP_KEY=

# Telegram Bot API (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram private chat ID; get it by sending /start to your bot
OWNER_TELEGRAM_CHAT_ID=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deriv API (use a trade-scoped PAT; never commit real values)
DERIV_APP_ID=
DERIV_ACCESS_TOKEN=
DERIV_ACCOUNT_ID=
# DEMO_ONLY=true blocks real-account trading even if credentials point to a real account.
DEMO_ONLY=true
ENABLE_LIVE_TRADING=false

# Risk controls
DEFAULT_STAKE=1
MAX_STAKE=2
MAX_TRADES_PER_DAY=5
MAX_DAILY_STAKE_RISK=5
MAX_OPEN_TRADES=1
SYMBOL=R_100
CANDLE_GRANULARITY=60
SCAN_INTERVAL_SECONDS=60

# Optional persistent SQLite path on Render
# DB_PATH=/opt/render/project/src/data/bot.db
